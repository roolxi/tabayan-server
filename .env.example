# OpenRouter API configuration for semantic search query suggestions
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=google/gemini-3.5-flash-lite

# Public video URL processing (seconds, bytes, concurrent jobs)
REMOTE_MEDIA_MAX_DURATION_SECONDS=600
REMOTE_MEDIA_MAX_SOURCE_BYTES=104857600
REMOTE_MEDIA_MAX_CONCURRENT_JOBS=3
